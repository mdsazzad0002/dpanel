DRUST_HTTP_BIND=0.0.0.0:80
DRUST_HTTPS_BIND=0.0.0.0:443
DRUST_PANEL_DOMAIN=panel.example.com
DRUST_DEFAULT_SITE_ROOT=/var/www/html

# Route user-owned websites to their dedicated PHP-FPM pool so PHP executes as
# site_owner instead of www-data. Missing pools are created on demand. Invalid
# owners or provisioning failures fall back to the shared www-data pool so the
# request remains available. System-scope sites always use www-data.
DRUST_SITE_POOLS=1
# DRUST_SITE_POOL_MAX_CHILDREN=4
