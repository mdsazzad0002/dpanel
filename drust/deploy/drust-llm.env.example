# Install as /etc/drust/llm.env with mode 0640 (root:drust-llm).
# Localhost only: the AI Gateway reaches it at http://127.0.0.1:9510/v1.
DRUST_LLM_BIND=127.0.0.1:9510
# Bearer key for every route. Enter the same value as the provider's API key
# when adding drust-llm to the AI Gateway.
DRUST_LLM_API_KEY=replace-with-a-long-random-key
DRUST_LLM_MODELS_DIR=/var/lib/drust/llm

# Used when a request sends no model or "auto".
# DRUST_LLM_DEFAULT_MODEL=qwen2.5-3b-instruct-q4_k_m

# Context window per request (capped at what the model was trained for).
DRUST_LLM_CTX_SIZE=4096
# Upper limit for max_tokens.
DRUST_LLM_MAX_TOKENS=2048
# CPU threads per generation. Unset = all cores but one.
# DRUST_LLM_THREADS=3
# Models kept in memory at once; loading another unloads the least recently used.
DRUST_LLM_MAX_LOADED=1
# Unload a model after this many idle seconds (0 = never).
DRUST_LLM_IDLE_UNLOAD_SECS=900
