[Unit]
Description=drust edge gateway
After=network.target mariadb.service mysql.service

[Service]
Type=simple
WorkingDirectory=/var/www/drust
EnvironmentFile=/etc/drust/edge-gateway.env
EnvironmentFile=/etc/drust/drust.env
Environment=DRUST_EDGE_GATEWAY_BIND=0.0.0.0:80
ExecStart=/usr/local/bin/drust-edge-gateway
Restart=always
RestartSec=3
# Every client connection (and each upstream one) is a file descriptor; the
# systemd default soft limit of 1024 caps the gateway near 1000 connections.
LimitNOFILE=1048576
User=root
Group=root
NoNewPrivileges=no
PrivateTmp=true
ProtectHome=false
ReadWritePaths=/var/www /home /etc/drust

[Install]
WantedBy=multi-user.target
