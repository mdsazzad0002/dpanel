#!/usr/bin/env bash
set -euo pipefail

# Run the newest drust binary. install-service.sh copies each release build to
# /usr/local/bin/drust and then removes target/ on a server; a development
# checkout keeps target/, so a fresh cargo build there wins until the next install.
DRUST_BIN=""
for candidate in /usr/local/bin/drust /var/www/drust/target/release/drust /var/www/drust/target/debug/drust; do
  [[ -x "$candidate" ]] || continue
  if [[ -z "$DRUST_BIN" || "$candidate" -nt "$DRUST_BIN" ]]; then
    DRUST_BIN="$candidate"
  fi
done
if [[ -z "$DRUST_BIN" ]]; then
  echo "drust binary not found; rebuild it with: sudo bash /var/www/drust/deploy/install-service.sh" >&2
  exit 1
fi

exec "$DRUST_BIN" \
  --port "${DRUST_API_PORT:-9500}" \
  --token "${DRUST_API_TOKEN}"
