#!/usr/bin/env bash
set -euo pipefail

DRUST_BIN="/var/www/drust/target/release/drust"
DEBUG_BIN="/var/www/drust/target/debug/drust"
if [[ -x "$DEBUG_BIN" && ( ! -x "$DRUST_BIN" || "$DEBUG_BIN" -nt "$DRUST_BIN" ) ]]; then
  # During an incremental update a verified debug build may be newer while a
  # release build is temporarily unavailable. The next release build takes
  # precedence automatically because it becomes the newest binary.
  DRUST_BIN="$DEBUG_BIN"
elif [[ ! -x "$DRUST_BIN" ]]; then
  DRUST_BIN="/var/www/drust/target/debug/drust"
fi

exec "$DRUST_BIN" \
  --port "${DRUST_API_PORT:-9500}" \
  --token "${DRUST_API_TOKEN}"
