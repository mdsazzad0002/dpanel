# Install as /etc/drust/drust.env with mode 0600.
# server hosts real sites; local is a developer's own machine.
DPANEL_PROFILE=server
DRUST_API_PORT=9500
DRUST_API_TOKEN=replace-with-a-long-random-token
DRUST_MAX_UPLOAD_SIZE_BYTES=10737418240
DRUST_MAX_ZIP_ENTRIES=100000
DRUST_MAX_ZIP_EXPANDED_BYTES=21474836480
DRUST_SCRIPTS_DIR=/opt/dpanel/runtime/scripts
DRUST_PANEL_ROOT=/var/www/dpanel
# Must be a CLI SAPI. Never point this at php-fpm.
DRUST_PHP_CLI=/usr/bin/php

# Each website under /home gets its own PHP-FPM pool running as the site account,
# so one site's PHP cannot read another site's files. Set to 0 to put every site
# back on the shared www-data pool.
DRUST_SITE_POOLS=1

# Worker ceiling for each site pool. Left unset it is derived from RAM and CPU
# count (the smaller of RAM/512MB and 2 x cores, clamped to 2-10).
# DRUST_SITE_POOL_MAX_CHILDREN=4

# Optional MariaDB/MySQL admin credentials used by /api/v1/database-request.
# Leave blank when MariaDB root unix_socket auth works for the root-owned drust service.
DRUST_DATABASE_ADMIN_USER=
DRUST_DATABASE_ADMIN_PASSWORD=
DRUST_DATABASE_ADMIN_HOST=127.0.0.1
DRUST_DATABASE_ADMIN_PORT=3306

# What issues website certificates: certbot (default) or acme, drust's own
# ACME client. With acme, new certificates go to /etc/drust/tls and win over
# a certbot certificate for the same domain; certbot's files are left alone,
# so switching back is safe. The mail hostname's certificate stays on
# certbot either way.
# DRUST_SSL_ENGINE=certbot
# The ACME directory. Let's Encrypt staging, to try it without rate limits:
# https://acme-staging-v02.api.letsencrypt.org/directory
# DRUST_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# Optional address for the CA's expiry notices.
# DRUST_ACME_EMAIL=
# Optional PEM file of extra roots to trust when the directory is a private CA.
# DRUST_ACME_CA_BUNDLE=
